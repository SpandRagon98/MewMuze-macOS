    { "id": "vent-01", "kind": "feel", "lang": "en", "text": "My manager moved my deadline up by a week and then left for vacation.", "expect": ["rant_buddy", "savage_bestie"], "anchors": ["manager", "deadline", "vacation", "week"] },
