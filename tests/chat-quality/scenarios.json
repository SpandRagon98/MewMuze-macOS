    { "id": "vent-05", "kind": "feel", "lang": "en", "text": "Traffic was insane and I was late for my own presentation.", "expect": ["rant_buddy", "calm_companion", "comfort_companion"], "anchors": ["traffic", "late", "presentation"] },
