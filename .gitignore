node_modules
dist
dist-ssr
*.local
.DS_Store
.vscode/*
!.vscode/extensions.json

# Rust / Tauri
src-tauri/target
src-tauri/gen/schemas

# Prebuilt PDFium (~7 MB), fetched by `npm run fetch:pdfium`.
# Not vendored: too large for the repo, and it should track upstream.
src-tauri/lib/

# whisper-cli for macOS, built by scripts/build-whisper-macos.sh (CI).
src-tauri/binaries/

# SECRETS — never commit these.
# .keys/updater.key signs update manifests; .keys/license.key mints licence
# keys. Anyone holding them can ship updates as you / forge licences.
.keys/
*.key
!*.key.pub
.env
.env.local

# ---- macOS port: additional belt-and-braces ignores -----------------------
# Certificates and key material of every shape. .keys/ and *.key are covered
# above; these are the formats Apple signing introduces.
*.pem
*.p12
*.pfx
*.cer
*.crt
*.mobileprovision
*.provisionprofile

# Every .env variant, not just .env.local.
.env.*
!.env.example

# Out-of-tree Cargo target dir used by this workspace.
cargo-target/

# Build products. A .app or .dmg belongs in a release, never in the repo.
*.app/
*.dmg
*.pkg
*.msi
*.exe
*.dylib
*.so

# Logs and CI artifacts pulled down for inspection.
*.log
/macOS-CI-Artifacts/
