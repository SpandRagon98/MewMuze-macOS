{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MewMuze",
  "mainBinaryName": "MewMuze",
  "version": "0.1.10",
  "identifier": "com.spandan.pixelcat",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "MewMuze",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": ["mewcostume"],
        "name": "MewMuze Costume",
        "description": "A signed visual costume package for MewMuze",
        "role": "Viewer",
        "mimeType": "application/vnd.mewmuze.costume"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installerIcon": "icons/installer.ico",
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["mewmuze"]
      }
    },
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCREM2MjI2QkYxMDczQTkKUldTcGN4Qy9KbUxjKzFlOXYrRnhYMkZudW5CS2JDUURCTEtkcUwyUXZBRzh0RDBITUxyZVpXeDMK",
      "endpoints": ["https://mewmuze.com/updates/latest.json"]
    }
  }
}
