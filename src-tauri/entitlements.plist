<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      MewMuze is a local desktop pet. It needs no sandbox exceptions beyond
      outbound network access, which is used ONLY by the optional Gmail (IMAP)
      and Calendar (.ics) connectors the user explicitly configures, and by the
      updater. Nothing else leaves the machine.

      Local Voice (optional) records only between an explicit Start and Stop,
      so it needs the microphone entitlement below; mic ACTIVITY for the cat's
      reactions is still read from CoreAudio device state without opening it.

      Deliberately NOT requested:
        - camera, contacts, calendars, photos, location
        - file access beyond the user-chosen .mewcostume package
    -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Local Voice: the recorder and dictation (Hardened Runtime requires it). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Hardened Runtime is required for notarisation. JIT is needed by the
         WKWebView JavaScript engine that renders the cat. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
